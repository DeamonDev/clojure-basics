{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.3"}}
 :aliases
 {;; REPL / editor alias: adds test sources, no :main-opts, so it never
  ;; hijacks REPL startup.  clj -A:dev   (or select "dev" in your IDE)
  :dev  {:extra-paths ["test"]}

  ;; clojure -M:test                      -> run all tests
  ;; clojure -M:test -n first-steps.core-test
  ;; clojure -M:test -v first-steps.challenges-test/c01-square-test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]}}}
